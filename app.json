{
  "expo": {
    "name": "I Love My Kinder",
    "slug": "i-love-my-kinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-client.jpg",
    "scheme": "ilovemykinder",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo-client.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo-client.jpg",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/logo-client.jpg"
          }
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Para sacar fotos y videos para el chat y la galería de la sala.",
          "microphonePermission": "Para grabar el sonido de los videos que subís a la galería de la sala."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Para guardar en tu galería las fotos y videos que elijas. Solo agregamos lo que vos guardás. Nunca vemos ni leemos tus fotos.",
          "granularPermissions": ["photo", "video"]
        }
      ],
      "react-native-compressor"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

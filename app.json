{
  "expo": {
    "name": "I Love My Kinder",
    "slug": "i-love-my-kinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-client.jpg",
    "scheme": "ilovemykinder",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo-client.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo-client.jpg",
          "imageWidth": 200,
          "dark": { "backgroundColor": "#FFFFFF", "image": "./assets/images/logo-client.jpg" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
